rules_version = '2';

// Co-op rooms for the Stardew Valley guide (see js/sync/coop.js).
// The room code is the shared secret: anyone signed in who knows it can
// join, but only members can read or write the room's progress, and each
// person can only add, edit or remove their own member entry.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(code) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(code)).data.members;
    }

    function validMember(m) {
      return m.keys().hasOnly(['name', 'joinedAt', 'lastSeen'])
        && m.name is string && m.name.size() > 0 && m.name.size() <= 24;
    }

    match /rooms/{code} {
      // get by exact code only; listing rooms is never allowed
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && code.matches('^[A-HJKMNP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['host', 'createdAt', 'members'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && validMember(request.resource.data.members[request.auth.uid]);

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.members)
            || validMember(request.resource.data.members[request.auth.uid]))
        && request.resource.data.members.size() <= 8;

      allow delete: if false;

      // One note per member (doc id = uid), max 1000 characters
      match /notes/{uid} {
        allow read: if isMember(code);
        allow write: if isMember(code)
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['text', 'name', 't'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 24;
      }

      // The in-game day last read from a member's save (Today tab)
      match /shared/{doc} {
        allow read: if isMember(code);
        allow write: if isMember(code)
          && doc == 'today'
          && request.resource.data.keys().hasOnly(['season', 'day', 'year', 'name', 'by', 'at'])
          && request.resource.data.season in ['spring', 'summer', 'fall', 'winter']
          && request.resource.data.day is int && request.resource.data.day >= 1 && request.resource.data.day <= 28
          && request.resource.data.year is int && request.resource.data.year >= 1 && request.resource.data.year <= 999
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at is int
          && request.resource.data.name is string && request.resource.data.name.size() <= 24;
      }

      match /progress/{domain} {
        allow read: if isMember(code);
        allow write: if isMember(code)
          && domain in ['recipes', 'quests', 'bundles', 'museum', 'gathered', 'planner']
          && request.resource.data.size() <= 600;
      }
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
