# Firebase web app config (Project settings -> Your apps -> Web app).
# Not secret: it ships to every browser. Access is enforced by firestore.rules.
# After editing, run: npm run config   (regenerates js/sync/firebase-config.js)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
